<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>..\pnp.core.snk</AssemblyOriginatorKeyFile>
    <RunSettingsFilePath Condition="'$(RunSettingsFilePath)' == '' and '$(VSTestTestCaseFilter)' == ''">$(MSBuildProjectDirectory)\offline.runsettings</RunSettingsFilePath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.6.3" />
    <PackageReference Include="MSTest.TestFramework" Version="3.6.3" />
    <PackageReference Include="Moq" Version="4.15.1" />
    <PackageReference Include="coverlet.collector" Version="6.0.0" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PnP.Core.Modernization\PnP.Core.Modernization.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Transform\**\*.xml;Transform\**\*.csv;Transform\**\*.html;Transform\**\*.aspx;Transform\**\*.jpg;Transform\**\*.png;Transform\**\*.pptx"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
