<Window x:Class="Demo.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Demo.WPF"
        mc:Ignorable="d"
        Title="PnP Core SDK demo" Height="450" Width="800" MinWidth="500" MinHeight="400">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="120"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <Button x:Name="btnSiteInfoAsync" Content="Site Information (Async)" HorizontalAlignment="Left" Height="34" Margin="23,25,0,0" VerticalAlignment="Top" Width="144" Click="btnSiteInfoAsync_Click" Grid.Row="0"/>
    <Button x:Name="btnSiteInfoSync" Content="Site Information (Sync)" HorizontalAlignment="Left" Height="34" Margin="23,76,0,0" VerticalAlignment="Top" Width="144" Click="btnSiteInfoSync_Click" Grid.Row="0"/>
    <Button x:Name="btnList" Content="List Information" HorizontalAlignment="Left" Height="34" Margin="192,26,0,0" VerticalAlignment="Top" Width="114" Click="btnList_Click" Grid.Row="0"/>
    <Button x:Name="btnTeam" Content="Teams Information" HorizontalAlignment="Center" Height="34" Margin="0,26,0,0" VerticalAlignment="Top" Width="116" Click="btnTeam_Click" Grid.Row="0"/>
    <TextBox x:Name="txtResults" Margin="10,10,10,10" TextWrapping="Wrap" IsReadOnly="True" Grid.Column="1" Grid.Row="1"/>
    <Button x:Name="btnAddPageAsync" Content="Add page (Async)" HorizontalAlignment="Left" Height="34" Margin="490,26,0,0" VerticalAlignment="Top" Width="144" Click="btnAddPageAsync_Click" Grid.Row="0"/>
    <Button x:Name="btnAddPageSync" Content="Add page (Sync)" HorizontalAlignment="Left" Height="34" Margin="490,76,0,0" VerticalAlignment="Top" Width="144" Click="btnAddPageSync_Click" Grid.Row="0"/>
  </Grid>
</Window>
