@page "/authentication/{action}"
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication

<RemoteAuthenticatorView Action="@Action">
    <LogInFailed Context="errorMessage">
        <p class="text-danger">There was an error logging you in: @errorMessage</p>
    </LogInFailed>
    <LogOutFailed Context="errorMessage">
        <p class="text-danger">There was an error logging you out: @errorMessage</p>
    </LogOutFailed>
</RemoteAuthenticatorView>

@code{
    [Parameter] public string? Action { get; set; }
}